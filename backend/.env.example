# 복사해서 .env 로 저장한 뒤 값을 채우세요.
# DART 인증키 (무료): https://opendart.fss.or.kr  → 인증키 신청
DART_API_KEY=여기에_DART_키

# Finnhub 키 (무료): https://finnhub.io/register
FINNHUB_API_KEY=여기에_Finnhub_키

# SEC EDGAR 는 키가 필요 없지만, User-Agent 에 연락처를 넣어야 차단되지 않습니다.
SEC_USER_AGENT=MyStockApp/0.1 (your-email@example.com)

# Supabase (대시보드 > Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
# service_role 키: 서버 전용. 절대 앱에 넣지 말 것.
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키

# FCM (Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 → JSON 다운로드)
# 다운받은 JSON 을 base64 로 인코딩한 값을 넣으세요.
#   리눅스:  base64 -w0 serviceAccount.json
#   macOS :  base64 -i serviceAccount.json
FCM_SERVICE_ACCOUNT=여기에_base64_인코딩된_서비스계정_JSON

# AI 공시 요약 (Gemini 무료): https://aistudio.google.com/apikey
# 비워두면 요약 없이 동작합니다.
GEMINI_API_KEY=여기에_Gemini_키

PORT=3000
